modules = ["go-1.21"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd TasteTech/backend && GOTOOLCHAIN=local PORT=5000 go run -mod=vendor ."
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd TasteTech/backend && GOTOOLCHAIN=local go build -mod=vendor -o /tmp/tastetech . && /tmp/tastetech"]

[[ports]]
localPort = 5000
externalPort = 80
